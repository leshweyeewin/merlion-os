# ─── MerlionOS Environment Variables ────────────────────────────────────────
# Copy this file to .env and fill in your keys.
# Real environment variables always win — values in .env are only defaults.

# ── Required ──────────────────────────────────────────────────────────────────
# Get a free API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Get from LTA DataMall: https://datamall.lta.gov.sg/content/datamall/en/request-for-api.html
LTA_DATAMALL_API_KEY="YOUR_LTA_DATAMALL_API_KEY"

# ── Optional: data.gov.sg ─────────────────────────────────────────────────────
# APIs work unauthenticated, but this key lifts the rate limit so NEA calls skip pacing.
DATA_GOV_SG_API_KEY="YOUR_DATA_GOV_SG_API_KEY"

# ── Optional: Google BigQuery (Job Market Dashboard) ─────────────────────────
# Without these the server falls back to live data.gov.sg fetches automatically.
# GCP_PROJECT_ID="your-gcp-project-id"
# GOOGLE_APPLICATION_CREDENTIALS="./service-account-key.json"

# ── Optional: Watchlists & Alerts ─────────────────────────────────────────────
# All optional — the My Alerts feed works without any of these; these add push channels.
# Web Push (browser notifications): generate with `py -3 scripts/gen_vapid_keys.py`.
# VAPID_PUBLIC_KEY="..."
# VAPID_PRIVATE_KEY="..."
# VAPID_SUBJECT="mailto:you@example.com"
#
# Telegram bot (phone notifications): create a bot with @BotFather, paste the token below.
# TELEGRAM_MODE defaults to "polling" (works locally, no public URL). Set to "webhook" on a host
# with a public HTTPS URL, then run `py -3 scripts/telegram_setup.py set <url>` (see the script).
# TELEGRAM_BOT_TOKEN="123456:ABC-your-bot-token"
# TELEGRAM_BOT_USERNAME="YourMerlionBot"      # without the @; enables the one-tap deep link in the UI
# TELEGRAM_MODE="polling"                      # polling | webhook
# TELEGRAM_WEBHOOK_SECRET="a-long-random-string"   # webhook mode only — authenticates incoming updates
#
# ALERTS_DB_PATH="./data/alerts.db"           # move to a persistent disk on Render for durability
# ALERTS_INTERVAL_SECONDS=300                 # how often the evaluator sweeps
# ALERTS_ENABLED=true                         # set false to disable the whole alert engine

# ── Optional: Server ──────────────────────────────────────────────────────────
# Default is 8000. Set to 8080 for Cloud Run compatibility.
# PORT=8000
# RELOAD=false
